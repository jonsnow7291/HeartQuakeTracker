{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "name": "EarthQuakeTracker Tactile Warmth Design Tokens",
  "movement": "Tactile Warmth & Organic Modernism",
  "accessibility": {
    "standard": "WCAG 2.1 AA",
    "minTouchTargetDp": 48,
    "panicTouchTargetDp": 96,
    "minTextContrastRatio": 4.5,
    "largeTextContrastRatio": 3.0
  },
  "light": {
    "colors": {
      "primary": "#2A1D13",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#DAC2B2",
      "onPrimaryContainer": "#25190F",

      "secondary": "#D47A22",
      "onSecondary": "#FFFFFF",
      "secondaryContainer": "#FE9C43",
      "onSecondaryContainer": "#6C3800",

      "tertiary": "#3D7D54",
      "onTertiary": "#FFFFFF",
      "tertiaryContainer": "#AEF2C0",
      "onTertiaryContainer": "#00210E",

      "auxiliary": "#3F6F8E",
      "onAuxiliary": "#FFFFFF",
      "auxiliaryContainer": "#C3DCEE",
      "onAuxiliaryContainer": "#0A2538",

      "panic": "#BA1A1A",
      "onPanic": "#FFFFFF",
      "panicContainer": "#FFDAD6",
      "onPanicContainer": "#410002",
      "terracottaAlert": "#C24726",

      "background": "#FDF9F2",
      "onBackground": "#1C1C18",
      "surface": "#FFFFFF",
      "onSurface": "#1C1C18",
      "surfaceVariant": "#E6E2DB",
      "onSurfaceVariant": "#4E453F",
      "outline": "#80756E",
      "outlineVariant": "#D1C4BC",

      "status": {
        "offline": "#80756E",
        "online": "#3D7D54",
        "syncing": "#3F6F8E",
        "beaconActive": "#BA1A1A",
        "lowPower": "#D47A22"
      }
    }
  },
  "dark": {
    "colors": {
      "primary": "#DAC2B2",
      "onPrimary": "#25190F",
      "primaryContainer": "#4A3525",
      "onPrimaryContainer": "#F7DECE",

      "secondary": "#FFB77D",
      "onSecondary": "#462400",
      "secondaryContainer": "#653800",
      "onSecondaryContainer": "#FFDDB3",

      "tertiary": "#93D5A5",
      "onTertiary": "#003915",
      "tertiaryContainer": "#1B4D2E",
      "onTertiaryContainer": "#AEF2C0",

      "auxiliary": "#86B6D6",
      "onAuxiliary": "#0A2538",
      "auxiliaryContainer": "#234960",
      "onAuxiliaryContainer": "#C3DCEE",

      "panic": "#FFB4AB",
      "onPanic": "#690005",
      "panicContainer": "#93000A",
      "onPanicContainer": "#FFDAD6",

      "background": "#1A1815",
      "onBackground": "#F4F0E9",
      "surface": "#23201C",
      "onSurface": "#F4F0E9",
      "surfaceVariant": "#4E453F",
      "onSurfaceVariant": "#D1C4BC",
      "outline": "#9E9087",
      "outlineVariant": "#4E453F",

      "status": {
        "offline": "#9E9087",
        "online": "#93D5A5",
        "syncing": "#86B6D6",
        "beaconActive": "#FFB4AB",
        "lowPower": "#FFB77D"
      }
    }
  },
  "spacing": {
    "none": 0,
    "space2xs": 4,
    "spaceXs": 8,
    "spaceSm": 12,
    "spaceMd": 16,
    "spaceLg": 20,
    "spaceXl": 24,
    "space2xl": 32,
    "space3xl": 40,
    "screenEdgePadding": 20,
    "cardInnerPadding": 16,
    "bottomNavHeight": 72,
    "headerBannerHeight": 64
  },
  "borderRadius": {
    "none": 0,
    "sm": 4,
    "default": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999
  },
  "typography": {
    "fontFamily": "Plus Jakarta Sans",
    "scale": {
      "headlineXl": { "fontSize": 32, "lineHeight": 38, "fontWeight": "800", "letterSpacing": -0.02 },
      "headlineLg": { "fontSize": 24, "lineHeight": 30, "fontWeight": "800", "letterSpacing": -0.01 },
      "headlineLgMobile": { "fontSize": 22, "lineHeight": 28, "fontWeight": "800" },
      "headlineMd": { "fontSize": 18, "lineHeight": 24, "fontWeight": "700" },
      "headlineSm": { "fontSize": 16, "lineHeight": 22, "fontWeight": "700" },
      "bodyLg": { "fontSize": 16, "lineHeight": 24, "fontWeight": "400" },
      "bodyMd": { "fontSize": 14, "lineHeight": 20, "fontWeight": "400" },
      "bodySm": { "fontSize": 12, "lineHeight": 16, "fontWeight": "400" },
      "labelLg": { "fontSize": 14, "lineHeight": 18, "fontWeight": "700", "letterSpacing": 0.02 },
      "labelMd": { "fontSize": 12, "lineHeight": 16, "fontWeight": "600", "letterSpacing": 0.01 },
      "labelCaps": { "fontSize": 11, "lineHeight": 14, "fontWeight": "800", "letterSpacing": 0.08 }
    }
  }
}
