# ---- Servidor (server/) ----
PORT=3000
# Sin DATABASE_URL el servidor usa memoria (solo desarrollo).
DATABASE_URL=postgres://eqt:eqt_dev@localhost:5432/eqt
# Carga server/seed/*.json al arrancar (datos NO verificados, solo desarrollo/demo)
SEED_ON_START=false
# Token Bearer de las rutas /admin (sin él responden 503)
ADMIN_TOKEN=cambiar-en-local
# Pepper para hashear códigos de socorrista (cámbialo en producción)
RESCUER_PEPPER=dev-pepper-cambiar
# Clave Ed25519 del servidor (PKCS8 DER en base64) para firmar la lista de socorristas; vacía = efímera
SERVER_SIGNING_KEY=
# Ventana de tolerancia de la firma de peticiones (ms) y límite por minuto (0 = sin límite)
SIGNATURE_SKEW_MS=300000
RATE_LIMIT_PER_MIN=120
# Tests contra PostgreSQL real (opcional)
TEST_DATABASE_URL=
# ---- App ----
APP_MODE=mock
